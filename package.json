{
  "name": "fontkit",
  "version": "2.0.4",
  "description": "An advanced font engine for Node and the browser",
  "keywords": [
    "opentype",
    "font",
    "typography",
    "subset",
    "emoji",
    "glyph",
    "layout"
  ],
  "scripts": {
    "test": "npm run build && npm run mocha",
    "mocha": "mocha",
    "build": "rolldown -c",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test",
    "prepublish": "npm run clean && npm run trie:data && npm run trie:use && npm run trie:indic && npm run build",
    "trie:data": "node scripts/generate-data.js",
    "trie:use": "node scripts/gen-use.js",
    "trie:indic": "node scripts/gen-indic.js",
    "clean": "node scripts/clean.js",
    "coverage": "c8 mocha"
  },
  "type": "module",
  "exports": {
    "node": {
      "import": "./dist/fontkit.node.esm.js",
      "require": "./dist/fontkit.node.cjs"
    },
    "import": "./dist/fontkit.browser.esm.js"
  },
  "files": [
    "src",
    "dist"
  ],
  "author": "Devon Govett <devongovett@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/foliojs/fontkit.git"
  },
  "dependencies": {
    "brotli": "^1.3.3",
    "clone": "^2.1.2",
    "dfa": "^1.2.0",
    "fast-deep-equal": "^3.1.3",
    "restructure": "^3.0.2",
    "tiny-inflate": "^1.0.3",
    "unicode-properties": "^2.0.1",
    "unicode-trie": "^3.0.0"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "codepoints": "^1.3.0",
    "concat-stream": "^2.0.0",
    "mocha": "^12.0.3",
    "prettier": "^3.9.9",
    "rolldown": "^1.2.13"
  }
}
